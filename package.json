{
  "name": "liar-game",
  "version": "0.1.0",
  "private": true,
  "description": "친구들과 함께하는 온라인 라이어 게임",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server --watch-path=shared --watch-path=words server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:words": "node scripts/check-words.ts",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@quasar/extras": "^2.1.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "sass-embedded": "^1.106.1",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
